---
import Layout from '../../../layouts/Layout.astro';
import Sidebar from '../../../components/Sidebar.astro';
---

<Layout title="Contact us" lang="en" activePage="contact" altLangHref="/contact/">
  <div class="page-intro">
    <h1>Contact us</h1>
  </div>

  <div class="content-area">
    <main class="main-content entry anim-up">
      <div class="breadcrumbs">
        <a href="/en/">Home</a><span class="sep">/</span><span>Contact us</span>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
        <div>
          <h1 style="padding-left:0;">Contact Pinso.</h1>
          <h2 style="font-size:16px; color:#2c5282;">PINSO BENELUX bvba<br />Antwerp – Amsterdam</h2>
        </div>
        <div style="text-align:center;">
          <img src="/logo/pinsobenelux-klein.png" alt="Pinso Benelux" style="width:120px; height:120px; object-fit:cover; border-radius:50%; border:3px solid #e0e8f5;" />
        </div>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
        <div>
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
            <span style="font-size:18px;">🇧🇪</span>
            <h4 style="font-size:14px; color:#1a365d; margin:0;">Call: +32 475 67 05 87</h4>
          </div>
          <h4 style="font-size:14px; color:#555; margin:4px 0 0 26px;">Fax: +32 3 303 52 10</h4>
        </div>
        <div>
          <div style="display:flex; align-items:center; gap:8px;">
            <span style="font-size:18px;">🇳🇱</span>
            <h4 style="font-size:14px; color:#1a365d; margin:0;">Call: +32 475 67 05 87</h4>
          </div>
          <div style="margin-top:4px; margin-left:26px;">
            <a href="mailto:info@pinso.be" style="color:#2c5282; font-size:13px;">info@pinso.be</a>
          </div>
        </div>
      </div>

      <div class="divider"></div>

      <div class="colored-box">
        <p style="font-size:14px; color:#1a365d; margin:0;">
          Contact us via <a href="mailto:info@pinso.be" style="color:#2c5282; font-weight:600;">info@pinso.be</a> or by phone.
        </p>
      </div>
    </main>

    <Sidebar lang="en" activePage="contact" side="right" showLogo={true} />
  </div>
</Layout>
